<div class="form-container" style="margin-top: 4rem; margin-bottom: 4rem; max-width: 600px;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <span style="font-size: 3rem;">🎾</span>
    <h2 class="form-title">Créer un compte</h2>
    <p style="color: var(--padel-gray); margin-top: 0.5rem;">
      Rejoignez PadelPro et commencez à réserver vos terrains
    </p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, "Adresse email", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "exemple@email.com" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Mot de passe", class: "form-label" %>
      <% if @minimum_password_length %>
        <span style="color: var(--padel-gray); font-size: 0.875rem; font-weight: normal;">
          (minimum <%= @minimum_password_length %> caractères)
        </span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "••••••••" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirmation du mot de passe", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", placeholder: "••••••••" %>
    </div>

    <div style="background: #dcfce7; border: 1px solid var(--padel-primary-light); border-radius: 0.5rem; padding: 1rem; margin: 1.5rem 0;">
      <p style="color: var(--padel-primary-dark); font-size: 0.875rem; margin: 0;">
        ✓ Réservation en ligne 24/7<br>
        ✓ Gestion de vos réservations<br>
        ✓ Notifications par email<br>
        ✓ Accès à tous nos courts
      </p>
    </div>

    <div style="margin-top: 2rem;">
      <%= f.submit "Créer mon compte", class: "form-submit" %>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
    <span style="color: var(--padel-gray);">Vous avez déjà un compte ?</span>
    <%= link_to "Se connecter", new_session_path(resource_name), style: "color: var(--padel-primary); text-decoration: none; font-weight: 600; margin-left: 0.5rem;" %>
  </div>
</div>
