<div class="form-container" style="margin-top: 4rem; margin-bottom: 4rem;">
  <div style="text-align: center; margin-bottom: 2rem;">
    <span style="font-size: 3rem;">🎾</span>
    <h2 class="form-title">Connexion</h2>
    <p style="color: var(--padel-gray); margin-top: 0.5rem;">
      Connectez-vous pour accéder à votre compte
    </p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <% if flash[:alert] %>
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :email, "Adresse email", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "exemple@email.com" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Mot de passe", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input", placeholder: "••••••••" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
        <%= f.check_box :remember_me, style: "width: auto;" %>
        <%= f.label :remember_me, "Se souvenir de moi", style: "margin-bottom: 0; font-weight: normal;" %>
      </div>
    <% end %>

    <div style="margin-top: 2rem;">
      <%= f.submit "Se connecter", class: "form-submit" %>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
    <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), style: "color: var(--padel-primary); text-decoration: none; font-weight: 500;" %>
  </div>

  <div style="text-align: center; margin-top: 1rem;">
    <span style="color: var(--padel-gray);">Pas encore de compte ?</span>
    <%= link_to "S'inscrire", new_registration_path(resource_name), style: "color: var(--padel-primary); text-decoration: none; font-weight: 600; margin-left: 0.5rem;" %>
  </div>
</div>
