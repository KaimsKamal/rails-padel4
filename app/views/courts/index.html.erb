<div class="dashboard-container">
  <div class="page-header">
    <h1 class="page-title">🎾 Courts de Padel</h1>
    <%= link_to "Mes Réservations", reservations_path, class: "btn btn-primary" %>
  </div>

  <% if @courts.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem;">
      <% @courts.each do |court| %>
        <div class="card">
          <div class="card-header">
            <div style="display: flex; justify-content: space-between; align-items: start;">
              <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--padel-dark); margin: 0;">
                <%= court.name %>
              </h2>
              <span class="badge badge-success">
                <%= court.status.capitalize %>
              </span>
            </div>
          </div>

          <div class="card-body">
            <div style="margin-bottom: 1rem;">
              <p style="color: var(--padel-gray); margin: 0.5rem 0;">
                <strong style="color: var(--padel-dark);">Type:</strong>
                <%= court.court_type.capitalize %>
              </p>

              <% if court.description.present? %>
                <p style="color: var(--padel-gray); margin-top: 1rem; font-size: 0.875rem;">
                  <%= court.description %>
                </p>
              <% end %>
            </div>
          </div>

          <div class="card-footer">
            <%= link_to "Voir détails", court_path(court), class: "btn btn-secondary", style: "flex: 1; text-align: center;" %>
            <%= link_to "Réserver", new_reservation_path(court_id: court.id), class: "btn btn-primary", style: "flex: 1; text-align: center;" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-warning">
      <p style="margin: 0;">Aucun court disponible pour le moment.</p>
    </div>
  <% end %>
</div>
