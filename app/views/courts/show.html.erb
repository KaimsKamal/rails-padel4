<div class="dashboard-container">
  <%= link_to "← Retour aux courts", courts_path, style: "color: var(--padel-primary); text-decoration: none; font-weight: 600; margin-bottom: 2rem; display: inline-block;" %>

  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 1rem;">
        <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--padel-dark); margin: 0;">
          🎾 <%= @court.name %>
        </h1>
        <span class="badge badge-success" style="font-size: 1rem; padding: 0.5rem 1rem;">
          <%= @court.status.capitalize %>
        </span>
      </div>
    </div>

    <div class="card-body">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--padel-dark); margin-bottom: 0.5rem;">
            Type de court
          </h3>
          <p style="color: var(--padel-gray);">
            <%= @court.court_type.capitalize %>
          </p>
        </div>

        <% if @court.description.present? %>
          <div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--padel-dark); margin-bottom: 0.5rem;">
              Description
            </h3>
            <p style="color: var(--padel-gray);">
              <%= @court.description %>
            </p>
          </div>
        <% end %>
      </div>

      <%= link_to "Réserver ce court", new_reservation_path(court_id: @court.id), class: "btn btn-primary", style: "font-size: 1.125rem; padding: 1rem 2rem;" %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: var(--padel-dark); margin: 0;">
        📅 Réservations à venir
      </h2>
    </div>

    <div class="card-body">
      <% if @reservations.any? %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          <% @reservations.each do |reservation| %>
            <div style="border-left: 4px solid var(--padel-primary); background: var(--padel-light-gray); padding: 1rem; border-radius: 0.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 1rem;">
                <div>
                  <p style="font-weight: 700; color: var(--padel-dark); margin: 0 0 0.5rem 0;">
                    <%= reservation.reservation_date.strftime("%d/%m/%Y") %>
                  </p>
                  <p style="color: var(--padel-gray); margin: 0;">
                    <%= reservation.start_time.strftime("%H:%M") %> - <%= reservation.end_time.strftime("%H:%M") %>
                  </p>
                </div>
                <span class="badge badge-success">
                  <%= reservation.status.gsub('_', ' ').capitalize %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p style="color: var(--padel-gray); font-style: italic; margin: 0;">
          Aucune réservation pour ce court.
        </p>
      <% end %>
    </div>
  </div>
</div>
